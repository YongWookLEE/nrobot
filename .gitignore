# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# allow env example (fake values only)
!.env.example

# 비공개 자료: 회사 가격표·맑은 고딕·비교용 실제 견적서·실제 가격표 기준 데이터
/private
# 가격표 변환 산출물 (빌드 전 단계에서 생성)
/generated
# 개발 도구 작업 공간
/.dryforge
