# 환경 변수 예시 파일 (가짜 값). 저장소에 올라가는 파일입니다.
# 사용법: 이 파일을 복사해 같은 폴더에 .env 로 저장한 뒤 실제 값으로 바꾸세요.
#   cp .env.example .env
# .env 는 저장소에 올라가지 않습니다. 배포할 때는 같은 값을 Vercel 환경 변수에 넣으세요.

# 입장 비밀번호. 비어 있으면 아무도 들어갈 수 없습니다. 바꾸면 모두 다시 입장해야 합니다.
APP_PASSWORD=change-me

# 담당자 명단 (JSON 배열, 한 줄로). id는 겹치면 안 되고, start는 하루 견적번호 시작값(1~999)입니다.
STAFF_CONFIG=[{"id":"a","name":"홍길동","title":"차장","phone":"010-0000-0001","start":1},{"id":"b","name":"김철수","title":"차장","phone":"010-0000-0002","start":10},{"id":"c","name":"이영희","title":"대리","phone":"010-0000-0003","start":20}]
